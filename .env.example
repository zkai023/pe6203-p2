# 复制本文件为 .env 后填写真实值（.env 已在 .gitignore 中，不会被提交）

# ---------- 方案 A：OpenAI 官方 Key（sk- 或 sk-proj- 开头） ----------
OPENAI_API_KEY=sk-在这里填你的OpenAI Key
# 不要设置 OPENAI_BASE_URL
AGENTDOJO_MODEL=gpt-4o-mini-2024-07-18

# ---------- 方案 B：OpenRouter Key（sk-or-v1- 开头） ----------
# 注意：这类 Key 打 OpenAI 官方端点会 401 —— Key 没错，是网关不对。
# 设置下面的 OPENAI_BASE_URL 即可（openai SDK 会自动读取该环境变量）
# OPENAI_API_KEY=sk-or-v1-在这里填你的OpenRouter Key
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter 的模型 id 必须带厂商前缀：
# AGENTDOJO_MODEL=openai/gpt-4o-mini

# 不确定选哪个？先跑 python scripts/check_key.py，它会告诉你该填什么。
